# NoteFlow Environment Template
# Copy this file to .env and insert your real production credentials for release builds.
# In debug mode or if .env is absent, safe official Google sample IDs are used automatically.

# Google AdMob Android Application ID (Required by AndroidManifest)
# Default below is Google's official sample test app ID
ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713

# Google AdMob Rewarded Video Ad Unit ID
# Default below is Google's official sample test ad unit ID
ADMOB_REWARDED_AD_UNIT_ID=ca-app-pub-3940256099942544/5224354917
